NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# 가격·상품 기능은 전역 스위치와 회사 목록이 모두 맞는 회사에서만 서버가 엽니다.
PRICE_SHEETS_ENABLED=false
FEATURE_PRICING_COMPANY_IDS=
FEATURE_STORE_COSTS_COMPANY_IDS=
STORE_MEMBER_SESSION_ENABLED=false

# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Server-only key. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# First-admin bootstrap only. Leave both blank after creating the first administrator in /admin/accounts.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=replace-with-random-long-secret
# WO-21 아이디 로그인·계정 관리. 승인된 SQL 적용 전에는 서버/화면 모두 false를 유지합니다.
ACCOUNT_LOGIN_V2_ENABLED=false
NEXT_PUBLIC_ACCOUNT_LOGIN_V2_ENABLED=false
# WO-21 2차 권한 묶음·일괄 적용. SQL 승인·적용 전에는 false를 유지합니다.
ROLE_PERMISSIONS_ENABLED=false

# Customer demo login
CUSTOMER_EMAIL=owner@maju.local
CUSTOMER_PASSWORD=replace-with-strong-password
CUSTOMER_COMPANY_ID=00000000-0000-4000-8000-000000000001

# Route intelligence
COMPANY_ORIGIN_ADDRESS=경기도 하남시 초이로 133 1층
TMAP_API_KEY=replace-with-tmap-api-key
OPINET_API_KEY=replace-with-opinet-api-key

# Map visualization
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=replace-with-kakao-javascript-key
KAKAO_REST_KEY=replace-with-kakao-rest-api-key

# 대표 승인 전 지도 필터 프리셋 DB 저장을 막습니다. SQL migration/API/cron을 함께 승인한 뒤에만 true로 전환합니다.
MAP_FILTER_PERSISTENCE_ENABLED=false
# 관리자 구 단위 집계 지도. 관리자 권한·회사 격리 검증이 끝난 환경에서만 true로 전환합니다.
ADMIN_MAP_OVERVIEW_ENABLED=false

# 상품 구분 트리 SQL이 승인·적용되기 전에는 편집 UI를 숨깁니다. 기존 category 문자열 조회는 계속 동작합니다.
PRODUCT_CATEGORIES_ENABLED=false

# WO-25 상세 행 감사 SQL(import_jobs/import_rows) 승인·적용 전에는 기존 업로드 이력만 사용합니다.
PRODUCT_IMPORT_AUDIT_V2_ENABLED=false
PRODUCT_IMPORT_TARGETS_ENABLED=false
# WO-25 22·23차 날짜별 기준 단가 Excel 열 매핑. SQL 운영 적용 전에는 비활성화합니다.
BASE_PRICES_ENABLED=false
# WO-25 17A 가져오기 미리보기 행별 수정 UI. 기존 가져오기 흐름 연결 전에는 비활성화합니다.
IMPORT_ROW_EDITOR_ENABLED=false
# 운영 적용된 거래처 원자 저장 RPC 전환. 회사 격리·재시도 검증 후에만 true로 전환합니다.
CUSTOMER_IMPORT_ATOMIC_RPC_ENABLED=false
# 공급상품 분류·추가 5칸 매핑. 운영 승인 전에는 false를 유지합니다.
COMPANY_FIELD_DEFINITIONS_ENABLED=false

# Naver 지역 검색 API (선택) — 네이버 지역검색 API가 map.naver.com 상세 링크를 직접 돌려주는
# 드문 경우에만 보조로 사용합니다. 미설정이어도 거래처 등록 시 상호명+주소 기준
# map.naver.com/p/search 지도 검색 딥링크가 항상 자동으로 채워지므로 기능은 그대로 동작합니다.
# https://developers.naver.com 에서 애플리케이션 등록 후 "검색" API를 사용 설정하면 발급됩니다.
NAVER_SEARCH_CLIENT_ID=replace-with-naver-client-id
NAVER_SEARCH_CLIENT_SECRET=replace-with-naver-client-secret

# 네이버 데이터랩 검색어 트렌드 API (선택, 영업리드 "키워드 검색량순" 정렬용) — 위 NAVER_SEARCH_*
# (네이버 지역검색)와는 별개의 API/키 쌍입니다. developers.naver.com이 아니라 NAVER API HUB
# (naverapihub.apigw.ntruss.com, 네이버클라우드플랫폼)에서 발급받습니다. 미설정 시 영업리드
# 화면에서 "검색량순" 정렬만 비활성화되고("네이버 검색량 API가 아직 연결되지 않아..." 안내가
# 뜸) 나머지 기능은 정상 동작합니다. lib/naver-datalab.ts 참고.
NCP_DATALAB_CLIENT_ID=replace-with-ncp-datalab-client-id
NCP_DATALAB_CLIENT_SECRET=replace-with-ncp-datalab-client-secret

# 비밀번호 찾기 이메일 발송 (선택) — 설정하지 않으면 재설정 토큰은 발급되지만 실제 이메일은
# 발송되지 않고 서버 로그에만 경고가 남습니다. https://resend.com 에서 API 키를 발급받으세요.
RESEND_API_KEY=
RESEND_FROM_EMAIL=MAJU Intelligence <onboarding@resend.dev>

# Document OCR
# Choose one provider. Naver CLOVA OCR is a practical first choice for Korean business licenses.
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=
UPSTAGE_API_KEY=
OPENAI_API_KEY=

# Business registration status (휴업/폐업) auto-check
# data.go.kr "국세청_사업자등록정보 진위확인 및 상태조회" service key.
NTS_BUSINESS_API_KEY=replace-with-data-go-kr-service-key
# Secures /api/cron/business-status (called daily by vercel.json "crons"). Vercel sets this
# automatically for cron requests once the env var exists — generate any random long string.
CRON_SECRET=replace-with-random-long-secret

# 이탈 위험 거래처 텔레그램 알림
# One shared bot for the whole platform. Create it via @BotFather, then each company invites
# the same bot into their own Telegram group and saves that group's chat_id in 회사 설정.
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token

# 구글 리뷰 수집 (거래처 카드 "리뷰 요약 · 키워드" 섹션 — 리뷰_자동수집_파이프라인_설계.md "옵션 B")
# Google Cloud Console(https://console.cloud.google.com)에서 프로젝트 생성 → "Places API" 활성화
# (결제 계정 연결 필요, 매달 소액 무료 크레딧 제공) → API 키 발급 후 여기에 넣으면 거래처 카드의
# "리뷰 새로고침" 버튼으로 구글 리뷰를 수집할 수 있습니다. Places API는 호출당 비용이 발생하므로
# 신규 거래처 등록 시 자동 호출이나 매일 새벽 cron 일괄 재조회는 하지 않습니다(2026-08-19 제거) —
# 담당자가 버튼을 눌렀을 때만 호출됩니다. 설정하지 않으면 이 기능은 자동으로 꺼진 채로 유지되고,
# 기존 수동 리뷰 입력 기능만 그대로 동작합니다.
GOOGLE_PLACES_API_KEY=replace-with-google-places-api-key

# 신규 리드 자동 수집 — 행정안전부_식품_일반음식점 조회서비스(공공데이터포털, 전국 약 229만 건)
# https://www.data.go.kr 에서 "행정안전부_식품_일반음식점 조회서비스"를 활용신청하면 발급됩니다.
# 즉시 사용 가능한 서비스키를 바로 받을 수 있고, 전국 데이터를 다룹니다. "최근 변경분만" 걸러주는
# 요청 파라미터가 없어(전체 스냅샷 조회만 가능) 한 번에 전국을 다 훑을 수 없다는 제약이 있습니다
# — lib/gov-restaurant.ts가 매일 날짜 기반으로 다른 구간을 훑도록 회전시켜 반복 호출하면 결국
# 전국을 다 훑지만, 완전 커버리지까지 며칠~몇 주가 걸릴 수 있습니다. 미설정 시 이 기능만 꺼진
# 채로 유지됩니다.
# (예전에는 별도로 localdata.go.kr(지방행정인허가데이터개방시스템) 연동도 있었지만, 그 사이트가
# 2026-04-16 폐쇄되고 데이터가 이 공공데이터포털로 통합되면서 위 소스가 그 역할을 대신하게 되어
# 2026-08-24 제거했습니다.)
GOV_RESTAURANT_API_KEY=replace-with-gov-restaurant-api-key

# 신규 리드 자동 수집 예비 경로 — 서울 열린데이터광장(openapi.seoul.go.kr) 서울시 일반음식점 인허가 정보
# https://data.seoul.go.kr 에서 인증키를 신청하면 발급됩니다. 서울만 다루는 대신(약 53만 건)
# 좌표계가 확정적(EPSG:5174)이라 좌표를 직접 변환해 채우므로 카카오 지오코더를 타지 않아 더
# 빠릅니다. GOV_RESTAURANT_API_KEY와 마찬가지로 최근 변경분 필터가 없어 매일 다른 구간을
# 훑도록 회전시킵니다(lib/seoul-restaurant.ts). 현재 HTTPS 인증키 경로가 확인되지 않아 아래
# 예비 플래그는 반드시 false를 유지하며, 신규 리드 기본 수집은 GOV_RESTAURANT_API_KEY의 HTTPS 원천입니다.
SEOUL_OPENDATA_API_KEY=replace-with-seoul-opendata-api-key
# 서울 원천은 HTTPS 인증키 경로가 확인될 때까지 예비 상태로 유지합니다. 기본 수집은 위 정부 HTTPS 원천입니다.
LEAD_SEOUL_SOURCE_ENABLED=false
# 운영자 전용 매장 면적 집계 API. 운영 DB를 읽기만 하며 승인 전에는 DB 조회 자체를 막습니다.
ADMIN_LEAD_STORE_AREA_PROFILE_ENABLED=false
# 승인된 서버 집계 SQL이 운영 DB에 적용되고 EXPLAIN 검토까지 끝난 뒤에만 함께 true로 전환합니다.
ADMIN_LEAD_STORE_AREA_RPC_ENABLED=false

# 고객사 월 이용료 자동결제(토스페이먼츠 자동결제/빌링 API, lib/toss-payments.ts) — 토스페이먼츠
# 개발자센터(https://developers.tosspayments.com)에서 상점을 만들면 테스트용 클라이언트키/
# 시크릿키가 바로 발급됩니다(가맹점 계약 전에도 테스트 결제는 가능). 실 서비스 자동결제는 토스의
# 추가 리스크 심사·계약이 필요합니다. NEXT_PUBLIC_TOSS_CLIENT_KEY는 브라우저에 노출되는 값이라
# NEXT_PUBLIC_ 접두사가 붙습니다 — TOSS_SECRET_KEY는 절대 클라이언트에 노출하면 안 됩니다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=replace-with-toss-client-key

# 승인 전 브레이크타임 입력 초안을 숨깁니다. DB 저장 구조 적용 후 true로 전환합니다.
NEXT_PUBLIC_LEAD_BUSINESS_HOURS_UI_ENABLED=false

# C6/N3 운영 승인 경계. 대표 실제 계정 검증과 SQL 별도 승인·적용 전에는 true로 바꾸지 않습니다.
STAFF_ACCESS_V2_ENABLED=false
SENSITIVE_ACCESS_LOGS_ENABLED=false
# 동일 계정 동시 기기 감지의 기록 전용 초안. 운영 승인 전에는 false를 유지합니다.
STAFF_SESSION_OBSERVATION_ENABLED=false
# 매장 상세의 공통 SQL 승인 전 기능입니다. 승인된 스키마·RLS·데이터 연결이 준비되기 전에는
# 반드시 false로 유지합니다. true 또는 1로 명시한 경우에만 UI의 OFF 안내가 해제됩니다.
NEXT_PUBLIC_STORE_DELIVERY_PROOF_HISTORY_ENABLED=false
NEXT_PUBLIC_LEAD_NATIVE_ATTACHMENTS_ENABLED=false
NEXT_PUBLIC_STORE_REVISION_HISTORY_ENABLED=false
TOSS_SECRET_KEY=replace-with-toss-secret-key
# 리드 공공 인허가 면적 저장/지도 표시. SQL 적용·분포 검증 전에는 둘 다 false 유지.
LEAD_STORE_AREA_ENABLED=false
NEXT_PUBLIC_LEAD_STORE_AREA_ENABLED=false
